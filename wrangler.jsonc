{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mirurip",
  "main": "./dist-worker/index.js",
  "compatibility_date": "2026-08-31",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  }
}
