# Optional Vite configuration for local development.
# Copy this file to .env only when you need to override a default.
#
# It is intentionally named env.example rather than .env.example: Cloudflare's
# Deploy to Cloudflare button treats .env.example entries as required secrets.

# Optional external metadata backend. Leave unset to use MiruRip's edge API.
VITE_BACKEND_URL=""

# Optional public analytics identifier.
VITE_GA_MEASUREMENT_ID=""

# Optional public AniList OAuth overrides. The application has sensible defaults.
VITE_CLIENT_ID=""
VITE_REDIRECT_URI=""

# Set this only when using the authorization-code OAuth flow. Its matching
# VITE_CLIENT_SECRET must be set as a Cloudflare Worker secret, never here.
VITE_ENABLE_AUTH_CODE_FLOW="false"
